---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import WhoWeWorkWith from '../components/WhoWeWorkWith.astro';
import FounderNote from '../components/FounderNote.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

const title = 'Tandempoint — Influencer Marketing for Developer Tools';
const description =
  'We connect developer-tool brands with the creators developers actually watch. Briefing, creator matching, and campaign management, run by engineers.';
---

<Base title={title} description={description}>
  <Nav />
  <main>
    <Hero />
    <HowItWorks />
    <WhoWeWorkWith />
    <FounderNote />
    <Contact />
  </main>
  <Footer />
</Base>
