---
const steps = [
  {
    n: '01',
    title: 'Brief',
    body: 'We learn your product, your positioning, and the developer you are actually trying to reach. If a creator campaign is the wrong channel for what you are selling, we tell you that.',
  },
  {
    n: '02',
    title: 'Match',
    body: 'We shortlist creators whose audience overlaps with that developer and whose technical credibility holds up. We watch the videos, read the comments, and look at what they have already said about tools like yours.',
  },
  {
    n: '03',
    title: 'Manage',
    body: 'We handle negotiation, briefs, deliverables, and reporting. You approve the shortlist and the brief. We run everything after that.',
  },
];
---

<section
  id="how-it-works"
  class="mx-auto max-w-page border-t border-border px-6 py-section-sm md:px-8 md:py-section"
  aria-labelledby="how-it-works-heading"
>
  <h2 id="how-it-works-heading" class="wordmark text-h2 text-text">How it works</h2>

  <ol class="mt-12 grid gap-10 md:grid-cols-3 md:gap-8">
    {
      steps.map((step) => (
        <li class="border-t border-border pt-6">
          <span class="text-small tabular-nums text-accent">{step.n}</span>
          <h3 class="wordmark mt-3 text-lead text-text">{step.title}</h3>
          <p class="mt-3 text-body text-muted">{step.body}</p>
        </li>
      ))
    }
  </ol>
</section>
