---
const steps = [
  {
    n: '01',
    title: 'Brief',
    body: 'We learn your product, your positioning, and the developer you are actually trying to reach. If a creator campaign is the wrong channel for what you are selling, we tell you that.',
  },
  {
    n: '02',
    title: 'Match',
    body: 'We shortlist creators whose audience overlaps with that developer and whose technical credibility holds up. We watch the videos, read the comments, and look at what they have already said about tools like yours.',
  },
  {
    n: '03',
    title: 'Manage',
    body: 'We handle negotiation, briefs, deliverables, and reporting. You approve the shortlist and the brief. We run everything after that.',
  },
];
---

<section
  id="how-it-works"
  class="mx-auto max-w-page border-t border-border px-6 py-section-sm md:px-8 md:py-section"
  aria-labelledby="how-it-works-heading"
>
  <h2
    id="how-it-works-heading"
    data-reveal
    class="wordmark border-l border-accent pl-6 text-h2 text-heading md:pl-8"
  >
    How it works
  </h2>

  <!-- The reveal targets are the heading and each card, never this section: a hidden parent would
       hide its children and the stagger would never be visible. -->
  <ol class="mt-12 grid gap-6 md:grid-cols-3">
    {
      steps.map((step, i) => (
        <li
          data-reveal
          style={`--reveal-delay: ${(i + 1) * 80}ms`}
          class="group relative overflow-hidden rounded-[var(--radius-card)] border border-border bg-surface-accent p-6 after:absolute after:top-0 after:left-0 after:h-px after:w-full after:origin-left after:scale-x-0 after:bg-accent after:transition-transform after:duration-300 after:ease-out hover:after:scale-x-100 focus-within:after:scale-x-100"
        >
          <span class="text-small tabular-nums text-accent">{step.n}</span>
          <h3 class="wordmark mt-3 text-lead text-heading">{step.title}</h3>
          <p class="mt-3 text-body text-muted">{step.body}</p>
        </li>
      ))
    }
  </ol>
</section>
