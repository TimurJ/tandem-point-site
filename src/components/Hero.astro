---
// The two clusters are deliberately near-invisible texture; the single accent path between them is
// the only saturated element in the composition. Coordinates are hand-placed rather than generated
// so the clusters read as loose rather than as a lattice.
const brandCluster = [
  { x: 42, y: 66 },
  { x: 18, y: 116 },
  { x: 74, y: 132 },
  { x: 36, y: 178 },
  { x: 88, y: 196 },
];

const creatorCluster = [
  { x: 262, y: 78 },
  { x: 316, y: 112 },
  { x: 288, y: 158 },
  { x: 338, y: 186 },
  { x: 268, y: 214 },
];

// Intra-cluster links, as index pairs into the arrays above.
const brandLinks = [
  [0, 1],
  [0, 2],
  [1, 3],
  [2, 3],
  [3, 4],
];
const creatorLinks = [
  [0, 1],
  [0, 2],
  [1, 3],
  [2, 3],
  [2, 4],
];

// The one joining path: from a brand node to a creator node, bowed slightly so it reads as a
// connection rather than a ruler line.
const joinFrom = { x: 74, y: 132 };
const joinTo = { x: 288, y: 158 };
---

<section
  class="relative mx-auto max-w-page px-6 pt-20 pb-section-sm md:px-8 md:pt-32 md:pb-section lg:grid lg:grid-cols-[minmax(0,60%)_1fr] lg:items-center lg:gap-12"
>
  <div class="relative z-10">
    <h1
      class="wordmark heading-gradient max-w-[20ch] text-[2.25rem] leading-[1.1] sm:text-[2.75rem] md:text-display lg:max-w-none"
    >
      We connect developer-tool brands with the creators developers actually watch.
    </h1>

    <p class="mt-6 max-w-[58ch] text-lead text-muted">
      A small influencer marketing agency for dev tools and technical SaaS. We come at this from the
      engineering side, so we look hard at the product and the creator before either one commits.
    </p>

    <a
      href="#contact"
      class="mt-10 inline-flex items-center rounded-[var(--radius-card)] bg-accent px-5 py-3 text-small font-medium text-accent-ink transition-[transform,filter] duration-150 hover:-translate-y-px hover:brightness-110"
    >
      Get in touch
    </a>
  </div>

  <!--
    Below lg this wrapper is an absolutely positioned band in the hero's top-right and holds only
    the glow. At lg it becomes grid column two and takes its size from the art, so the glow inside
    is centred on the art itself rather than on the hero.
  -->
  <div
    class="pointer-events-none absolute top-0 right-0 h-[20rem] w-[20rem] lg:relative lg:top-auto lg:right-auto lg:h-auto lg:w-auto"
    aria-hidden="true"
  >
    <div
      class="hero-glow absolute top-1/2 left-1/2 z-0 h-[20rem] w-[20rem] -translate-x-1/2 -translate-y-1/2 lg:h-[38rem] lg:w-[38rem]"
    >
    </div>

    <svg
      class="relative z-10 hidden h-auto w-full lg:block"
      viewBox="0 0 380 280"
      fill="none"
      focusable="false"
    >
    {
      [
        { nodes: brandCluster, links: brandLinks },
        { nodes: creatorCluster, links: creatorLinks },
      ].map(({ nodes, links }) => (
        <g>
          {links.map(([a, b]) => (
            <line
              x1={nodes[a].x}
              y1={nodes[a].y}
              x2={nodes[b].x}
              y2={nodes[b].y}
              stroke="var(--color-border)"
              stroke-width="1"
            />
          ))}
          {nodes.map((node) => (
            <circle cx={node.x} cy={node.y} r="3" fill="var(--color-control-border)" />
          ))}
        </g>
      ))
    }

    <path
      class="hero-link"
      pathLength="1"
      d={`M ${joinFrom.x} ${joinFrom.y} C 150 108, 212 182, ${joinTo.x} ${joinTo.y}`}
      stroke="var(--color-accent)"
      stroke-width="1.25"
      stroke-linecap="round"
    />

    <circle class="hero-pulse" cx={joinFrom.x} cy={joinFrom.y} r="8" fill="var(--color-accent)" opacity="0.14" />
    <circle class="hero-pulse" cx={joinTo.x} cy={joinTo.y} r="8" fill="var(--color-accent)" opacity="0.14" />
    <circle cx={joinFrom.x} cy={joinFrom.y} r="4" fill="var(--color-accent)" />
    <circle cx={joinTo.x} cy={joinTo.y} r="4" fill="var(--color-accent)" />
    </svg>
  </div>
</section>
