---
// The form posts to /api/contact on this same origin, served by src/worker.ts. There is no
// build-time configuration left: the endpoint is a fixed path and the Resend key never leaves
// the Worker.
const fields = [
  { id: 'name', label: 'Name', type: 'text', autocomplete: 'name' },
  { id: 'company', label: 'Company', type: 'text', autocomplete: 'organization' },
  { id: 'email', label: 'Email', type: 'email', autocomplete: 'email' },
];
---

<section
  id="contact"
  class="mx-auto max-w-page border-t border-border px-6 py-section-sm md:px-8 md:py-section"
  aria-labelledby="contact-heading"
>
  <h2
    id="contact-heading"
    data-reveal
    class="wordmark border-l border-accent pl-6 text-h2 text-heading md:pl-8"
  >
    Get in touch
  </h2>

  <p data-reveal style="--reveal-delay: 80ms" class="mt-4 max-w-[54ch] text-body text-muted">
    Tell us about your product and the developers you want in front of it. We read and reply to
    everything.
  </p>

  <form id="contact-form" class="mt-10 max-w-[34rem]">
    <div class="grid gap-5">
      {
        fields.map((field) => (
          <div>
            <label for={field.id} class="block text-small text-text">
              {field.label}
            </label>
            <input
              id={field.id}
              name={field.id}
              type={field.type}
              autocomplete={field.autocomplete}
              required
              class="mt-2 w-full rounded-[var(--radius-card)] border border-control-border bg-surface px-3 py-2.5 text-body text-text transition-[border-color,box-shadow] duration-150 outline-none focus-visible:border-accent focus-visible:shadow-[0_0_0_3px_color-mix(in_oklab,var(--color-accent)_25%,transparent)] focus-visible:outline-none"
            />
          </div>
        ))
      }

      <div>
        <label for="message" class="block text-small text-text">Message</label>
        <textarea
          id="message"
          name="message"
          rows="5"
          required
          class="mt-2 w-full resize-y rounded-[var(--radius-card)] border border-control-border bg-surface px-3 py-2.5 text-body text-text transition-[border-color,box-shadow] duration-150 outline-none focus-visible:border-accent focus-visible:shadow-[0_0_0_3px_color-mix(in_oklab,var(--color-accent)_25%,transparent)] focus-visible:outline-none"
        ></textarea>
      </div>

      {/* Honeypot. sr-only takes it out of the layout without display:none, which some bots skip;
          aria-hidden and tabindex -1 keep it away from screen readers and the tab order. The
          Worker silently discards any submission that fills it in. */}
      <div aria-hidden="true" class="sr-only">
        <label for="website">Website</label>
        <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>
    </div>

    <button
      type="submit"
      id="contact-submit"
      class="mt-8 inline-flex items-center rounded-[var(--radius-card)] bg-accent px-5 py-3 text-small font-medium text-accent-ink transition-[transform,filter,opacity] duration-150 hover:-translate-y-px hover:brightness-110 disabled:translate-y-0 disabled:opacity-60 disabled:brightness-100"
    >
      Send message
    </button>
  </form>

  <p
    id="contact-status"
    role="status"
    aria-live="polite"
    tabindex="-1"
    class="mt-6 max-w-[54ch] text-body text-muted empty:mt-0"
  >
  </p>

  <p class="mt-8 text-small text-muted">
    or email <a
      href="mailto:hello@tandempoint.io"
      class="relative inline-block text-accent underline decoration-accent/40 underline-offset-4 after:absolute after:bottom-[-0.3em] after:left-0 after:h-px after:w-full after:origin-left after:scale-x-0 after:bg-accent after:transition-transform after:duration-300 after:ease-out hover:after:scale-x-100 focus-visible:after:scale-x-100"
      >hello@tandempoint.io</a
    >
  </p>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('contact-status');
  const submit = document.getElementById('contact-submit') as HTMLButtonElement | null;

  const GENERIC_ERROR =
    'Something went wrong sending that. Email hello@tandempoint.io and we will pick it up there.';

  if (form && status && submit) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (!form.reportValidity()) return;

      status.textContent = '';
      status.classList.remove('text-accent');
      submit.disabled = true;
      submit.textContent = 'Sending…';

      const fail = (message: string) => {
        status.textContent = message;
        status.classList.remove('text-accent');
        submit.disabled = false;
        submit.textContent = 'Send message';
        status.focus();
      };

      try {
        const entered = new FormData(form);
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            name: entered.get('name'),
            company: entered.get('company'),
            email: entered.get('email'),
            message: entered.get('message'),
            website: entered.get('website'),
          }),
        });

        if (response.ok) {
          form.hidden = true;
          status.textContent = 'Thanks. Your message is in, and we will reply from hello@tandempoint.io.';
          status.classList.add('text-accent');
          status.focus();
          return;
        }

        // The Worker answers with { error } on a validation failure; anything it cannot phrase
        // usefully (rate limit, upstream failure) already carries the generic copy.
        const body = (await response.json().catch(() => null)) as { error?: string } | null;

        fail(typeof body?.error === 'string' && body.error ? body.error : GENERIC_ERROR);
      } catch {
        fail(GENERIC_ERROR);
      }
    });
  }
</script>
