# Formspree endpoint for the contact form.
# Create a form at https://formspree.io and paste its endpoint here.
# The PUBLIC_ prefix is required: Astro only exposes PUBLIC_ variables to client-side code,
# and the value is inlined at build time (so it must also be set in the Cloudflare Pages
# project's build environment, not only at runtime).
PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxxx
