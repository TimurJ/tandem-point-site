# Cloudflare Workers serves every asset with `public, max-age=0, must-revalidate` by default.
# Correct for index.html and the sitemaps; wasteful for files whose name contains a content
# hash, which cannot change meaning and so never need revalidating.
#
# Only these two paths are overridden. og.png, favicon.svg, wordmark.svg and robots.txt are
# deliberately left on the default: they are unhashed and regenerated by `pnpm og`, so a long
# cache would strand a rebrand behind stale copies.
#
# A line is treated as a new path rule purely by starting with "/", so never add a header whose
# value begins with a slash here. It would be reparsed as a path and swallow the rules below it.

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Not hash-named, unlike /_astro/*: the filename encodes weight and variant. If a font is ever
# replaced, rename the file, which the <link rel="preload"> in Base.astro requires anyway.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
